# Maintainer: GabrielBaiano <gabrielngama@gmail.com>
pkgname=ashen-pomodoro
pkgver=2.0.0
pkgrel=1
pkgdesc="Soulsborne 3D TrueColor ANSI Pomodoro timer for the terminal (Dark Souls, Bloodborne, Wood Hearth)"
arch=('x86_64' 'aarch64')
url="https://github.com/GabrielBaiano/ashen-pomodoro"
license=('GPL-3.0-only')
depends=('glibc')
makedepends=('make' 'gcc')
conflicts=('bonfire-pomodoro')
replaces=('bonfire-pomodoro')
optdepends=(
    'libnotify: background desktop notifications'
    'pipewire: ambient audio and alert chimes'
    'pulseaudio: ambient audio and alert chimes'
    'alsa-utils: ambient audio and alert chimes'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('26dd382da11d48a201cc51b3f9bd8ec982f2ca5f4e8bd594a1b76b698edd2011')

build() {
    cd "$pkgname-$pkgver"
    make
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 bonfire "$pkgdir/usr/bin/bonfire"
    ln -s bonfire "$pkgdir/usr/bin/ashen"
    ln -s bonfire "$pkgdir/usr/bin/fireplace"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
